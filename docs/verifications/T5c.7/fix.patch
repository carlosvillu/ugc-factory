+ *     (o un step inexistente) es una inconsistencia de datos que reintentar la descarga no arregla.
+ */
+async function resolveBrollVideoAssetKind(
+  db: DbClient,
+  generation: Generation,
+): Promise<'broll_clip' | 'cta_clip'> {
