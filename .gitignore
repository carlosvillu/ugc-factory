# dependencias y builds
node_modules/
dist/
.next/
coverage/
*.tsbuildinfo

# next-env.d.ts es un ARTEFACTO regenerado por Next: `next dev` lo apunta a
# `.next/dev/types/routes.d.ts` y `next build` a `.next/types/routes.d.ts`. Con el stack
# E2E en modo producción (T5.22) cada corrida hace `next build` y lo reescribiría, ensuciando
# el árbol en cada gate. Es lo que `create-next-app` ya gitignora upstream; typecheck pasa sin
# él (tsc lo regenera/no lo necesita), verificado en T5.22.
apps/web/next-env.d.ts

# entornos con secretos reales (los .env.test committeados llevan claves falsas)
.env
.env.local
.env.*.local

# datos y artefactos de runtime
/data/
playwright-report/
test-results/

# E2E Playwright: sesión persistida del setup + runtime del stack (efímeros)
apps/web/e2e/.auth/
apps/web/e2e/.runtime.json

# claude code — local de máquina, no del proyecto
.claude/settings.local.json

# sistema
.DS_Store

# artefactos locales de claude code
.claude/scheduled_tasks.lock

# artefactos de otros arneses de agentes (espejos locales de máquina, no del proyecto)
.agents/
